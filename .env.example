# ==============================================================================
# TextGenerators Backend — Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging values.
# DO NOT commit real secrets or credentials to source control.

# Server
PORT=4000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
# IMPORTANT: JWT_SECRET MUST match the JWT_SECRET configured on the Next.js Frontend
JWT_SECRET=generate-a-strong-random-32+-char-secret-here
JWT_EXPIRES_IN=7d

# Google Gemini AI Translation
GEMINI_API_KEY=your-gemini-api-key-here

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=textgenerators-prod

# Default Super Admin (Used only on first boot to seed initial admin user if collection is empty)
DEFAULT_ADMIN_EMAIL=admin@textgenerators.net
DEFAULT_ADMIN_PASSWORD=change-this-to-a-secure-password
DEFAULT_ADMIN_NAME=Super Admin

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://textgenerators.net,https://www.textgenerators.net

# Optional Rate Limiter (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
